DRIVER=~fastapi
HOST=127.0.0.1
# NapCat's OneBot reverse WebSocket port.
PORT=9090
# Empty NAPCAT_QQ means QR login.
NAPCAT_QQ=
LOG_LEVEL=INFO
API_TIMEOUT=30
SUPERUSERS=[]
COMMAND_START=/
ALCONNA_COMMAND_START=/

# Startup update source. MODE=dev or off disables it.
# Set BAKA666BOT_UPDATE_REPO=MCPsDE/Baka666bot to follow upstream.
BAKA666BOT_UPDATE_REPO=InFengQwQ/Baka666bot
BAKA666BOT_UPDATE_BRANCH=main
BAKA666BOT_UPDATE_MODE=auto

# RENDER_BACKEND is required by nonebot-plugin-htmlrender.
# Empty REWORK_BROWSER_CHANNEL uses Playwright's Chromium instead of Edge.
RENDER_BACKEND=playwright
REWORK_BROWSER_CHANNEL=

# Optional service settings
osu_client=
osu_key=
POLLINATIONS_KEY=
arcaea_reply=

# Malody API client settings
MALODY_API_BASE=https://api.mugzone.net
MALODY_VERSION=6.6.43
MALODY_VER=394795
MALODY_STORE_API=202409
MALODY_TIMEOUT=10

