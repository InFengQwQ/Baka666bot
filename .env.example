DRIVER=~fastapi
HOST=127.0.0.1
# Must match the port used by NapCat's OneBot reverse WebSocket.
PORT=8080
LOG_LEVEL=INFO
API_TIMEOUT=30
SUPERUSERS=[]
COMMAND_START=/
ALCONNA_COMMAND_START=/

# Startup auto-update source.
# Leave REPO empty to use MCPsDE/Baka666bot, or set it to a fork such as owner/repo.
# MODE=dev, off or disabled turns startup auto-update off.
BAKA666BOT_UPDATE_REPO=
BAKA666BOT_UPDATE_BRANCH=main
BAKA666BOT_UPDATE_MODE=auto

# Renderer settings.
# RENDER_BACKEND is required by nonebot-plugin-htmlrender.
# An empty REWORK_BROWSER_CHANNEL uses the bundled Chromium instead of Edge.
RENDER_BACKEND=playwright
REWORK_BROWSER_CHANNEL=

# Optional service settings
osu_client=
osu_key=
POLLINATIONS_KEY=
arcaea_reply=

# Malody API client settings
MALODY_API_BASE=https://api.mugzone.net
MALODY_VERSION=6.6.43
MALODY_VER=394795
MALODY_STORE_API=202409
MALODY_TIMEOUT=10

# Optional NapCat QR upload support for NapCat_Daemon.ps1
NAPCAT_QRCODE_GITHUB_TOKEN=
