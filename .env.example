# 必填
DRIVER=~fastapi+~httpx  # httpx 提供下载图片用的 HTTP 客户端
HOST=127.0.0.1
PORT=9090  # 与 NapCat 的反向 WebSocket 端口一致
RENDER_BACKEND=playwright
NAPCAT_QQ=  # 填上 QQ 号，重启后不用扫码
SUPERUSERS=[]  # 填自己的 QQ 号

# 可选，保留默认值
# LOG_LEVEL=INFO
# API_TIMEOUT=30
# COMMAND_START=/
# ALCONNA_COMMAND_START=/
# REWORK_BROWSER_CHANNEL=

# 启动更新检查；dev 或 off 关闭
# BAKA666BOT_UPDATE_REPO=InFengQwQ/Baka666bot
# BAKA666BOT_UPDATE_BRANCH=main
# BAKA666BOT_UPDATE_MODE=auto

# osu! API
# osu_client=
# osu_key=

# rework 谱面源
# 多个镜像用逗号分隔，按序尝试
# 官方 .osz 只给登录用户，匿名只能用镜像
# REWORK_BEATMAP_URL=https://osu.ppy.sh/osu/{id}
# REWORK_BEATMAPSET_URL=https://osu.direct/api/d/{id},https://dl.sayobot.cn/beatmaps/download/novideo/{id}

# 图片生成
# POLLINATIONS_KEY=

# Malody API
# MALODY_API_BASE=https://api.mugzone.net
# MALODY_VERSION=6.6.43
# MALODY_VER=394795
# MALODY_STORE_API=202409
# MALODY_TIMEOUT=10
