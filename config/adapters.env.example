# Copy this file to config/adapters.env and fill in the accounts you want to enable.
# The runtime loads this file after .env, so it can hold adapter-specific settings.

# The aiohttp forward driver provides both HTTP and WebSocket clients for the
# Discord and Telegram adapters without changing the FastAPI reverse driver.
DRIVER=~fastapi+~aiohttp

# Discord Developer Portal -> Bot -> Token.
# message_content must also be enabled in the Discord Developer Portal if the bot
# should read ordinary channel messages instead of only mentions, replies and DMs.
DISCORD_BOTS='[
  {
    "token": "PASTE_DISCORD_BOT_TOKEN_HERE",
    "intent": {
      "guild_messages": true,
      "direct_messages": true,
      "message_content": true
    },
    "application_commands": {"*": ["*"]}
  }
]'

# Telegram BotFather -> /newbot token.
# Long polling is used when no webhook URL is configured.
# For ordinary group messages, use /setprivacy in BotFather and choose Disable.
TELEGRAM_BOTS='[
  {
    "token": "PASTE_TELEGRAM_BOT_TOKEN_HERE"
  }
]'

# Optional network settings:
# DISCORD_PROXY=http://127.0.0.1:7890
# TELEGRAM_PROXY=http://127.0.0.1:7890

# To keep the template safe to copy, replace the two token placeholders before
# starting the bot. Empty lists are also valid when only QQ is enabled:
# DISCORD_BOTS=[]
# TELEGRAM_BOTS=[]
